# Copy to .env.local (project root, never public/) and fill in. Both are public, inlined at build time.

# Web3Forms access key for the contact form (https://web3forms.com). Without it the form offers a mailto: link.
NEXT_PUBLIC_WEB3FORMS_KEY=

# The site's public origin, without a trailing slash (e.g. https://example.com).
# Used for canonical URLs, Open Graph, the sitemap and the contact QR code.
NEXT_PUBLIC_SITE_URL=
